HOST=127.0.0.1
PORT=8082
# 正式部署须改为访问者实际使用的完整网址（不带路径）。本机调试可留空。
PUBLIC_ORIGIN=
# 同一实例可额外允许的完整网址（逗号分隔），如保留本机调试入口。
ADDITIONAL_ORIGINS=
STATE_DIRECTORY=./data
COOKIE_SECURE=false
UPSTREAM_ORIGIN=https://bigfivepersonality.me
# 只影响服务访问原站/钉钉，不传给浏览器；Node 24 --use-env-proxy 读取系统代理。
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_BASE_ID=
DINGTALK_SHEET_ID_OR_NAME=
DINGTALK_OPERATOR_ID=
# 默认字段名：五维（数字/百分比）、人格类型（单选）、描述（富文本）、链接、写入时间、更新时间
DINGTALK_FIELD_MAP={}
RETRY_BASE_MS=10000
RETRY_MAX_MS=300000
WORKER_INTERVAL_MS=2000

# 人事登记入口：使用钉钉 OAuth 登录，不额外校验企业成员、在职状态或部门；不需要 CorpId。
HR_PORTAL_ENABLED=true
